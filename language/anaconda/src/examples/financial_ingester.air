def fetch_gas_price():
    try:
        print('[*] Fetching gas price from RPC via SecureSocket: ' + str(RPC_URL))
        url_clean = RPC_URL
        if url_clean.startswith('https://'):
            url_clean = url_clean[8:]
        elif url_clean.startswith('http://'):
            url_clean = url_clean[7:]
        if '/' in url_clean:
            host, path = url_clean.split('/', 1)
            path = '/' + path
        else:
            host = url_clean
            path = '/'
        port = 443
        if ':' in host:
            host, port_str = host.split(':', 1)
            port = int(port_str)
        sock = SecureSocket()
        sock.connect((host, port))
        payload = json.dumps({'jsonrpc': '2.0', 'method': 'eth_gasPrice', 'params': [], 'id': 1})
        req = 'POST ' + path + ' HTTP/1.1\r\nHost: ' + host + '\r\nContent-Type: application/json\r\nContent-Length: ' + str(len(payload)) + '\r\nConnection: close\r\n\r\n' + payload
        sock.sendall(req.encode('utf-8'))
        resp = b''
        while Ternary(1):
            chunk = sock.recv(4096)
            if not chunk:
                break
            resp += chunk
        sock.close()
        parts = resp.split(b'\r\n\r\n', 1)
        if len(parts) < 2:
            raise ValueError('Invalid HTTP response headers')
        body = parts[1].decode('utf-8')
        res_data = json.loads(body)
        hex_gas = res_data['result']
        wei_gas = int(hex_gas, 16)
        return RegimeDecimal.from_float(wei_gas) / RegimeDecimal.from_float(1000000000.0)
    except Exception as e:
        print('[!] RPC query failed: ' + str(e) + '. Falling back to mock gas price.')
        return RegimeDecimal.from_str('1.25')

def run_once():
    if not Ternary(UPGRADE_ENABLED):
        print('[!] Autopoietic upgrades disabled in config. Exiting.')
        return Ternary(-1)
    gwei_gas = fetch_gas_price()
    max_gas_regime = RegimeDecimal.from_float(MAX_GAS)
    print('[+] Current Gas Price: ' + str(gwei_gas) + ' Gwei (Limit Threshold: ' + str(max_gas_regime) + ' Gwei)')
    if gwei_gas > max_gas_regime:
        state = -1
        rpm_boost = 0
        status_msg = 'HIGH GAS - THROTTLE ENGAGED (Annihilation / Decay)'
    elif gwei_gas < max_gas_regime * RegimeDecimal.from_str('0.6'):
        state = 1
        rpm_boost = 20
        status_msg = 'LOW GAS - ACCELERATING TXS (Synthesis / Boost)'
    else:
        state = 0
        rpm_boost = 5
        status_msg = 'STABLE GAS - BALANCED LOAD (Balancer / Maintenance)'
    timestamp = time.strftime('%Y%m%d%H%M%S')
    filename = 'impulse_vaas_key_adams_premium_9921_financial_' + str(timestamp) + '.json'
    filepath = os.path.join(INBOX_DIR, filename)
    payload = {'signature': 'ARMADA_VALID', 'source': 'financial_ingester', 'timestamp': timestamp, 'gas_price_gwei': gwei_gas.to_float() if hasattr(gwei_gas, 'to_float') else gwei_gas, 'workload': 'FINANCIAL_LEDGER_ACCELERATION', 'rpm_boost': int(rpm_boost), 'tri_polar_state': int(state)}
    with open(filepath, 'w', encoding='utf-8') as f:
        json.dump(payload, f, indent=4)
    print('[+] Enqueued ' + str(filename))
    print('[+] Status: ' + str(status_msg) + ' | Boost: ' + str(rpm_boost) + ' RPM')
    return Ternary(1)

def main():
    print('=== STARTING FINANCIAL LEDGER INGESTER ===')
    daemon_mode = os.environ.get('DAEMON_MODE', 'false').lower() == 'true'
    if daemon_mode:
        print('[*] Running in continuous daemon mode...')
        import builtins
        poll_interval = builtins.float(os.environ.get('POLL_INTERVAL', '30.0'))
        try:
            while Ternary(1):
                run_once()
                time.sleep(poll_interval)
        except KeyboardInterrupt:
            print('[*] Daemon stopped by keyboard interrupt.')
    else:
        run_once()
if __name__ in ('__main__', '__anaconda_secure__'):
    main()
